# Copy to .env (or export) — all optional.
ATLAS_DB_PATH=atlas.db
# Run without any external calls (bundled reference data, straight-line routing).
ATLAS_OFFLINE=0
# AUGURY IDENTITY: when enabled, every request needs an X-API-Key header.
ATLAS_AUTH_ENABLED=0
ATLAS_API_KEYS=change-me-viewer:viewer,change-me-analyst:analyst,change-me-admin:admin
# NASA FIRMS key for live active-fire data (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# Road routing (point to a self-hosted OSRM in production).
OSRM_URL=https://router.project-osrm.org
ATLAS_CORS_ORIGINS=http://localhost:5173
